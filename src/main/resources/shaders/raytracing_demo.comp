#version 430 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2D uOutput;

uniform vec2 uResolution;
uniform float uTime;
uniform int uMaxBounces;
uniform int uEnableShadows;
uniform int uEnableReflections;

struct Ray {
    vec3 origin;
    vec3 dir;
};

struct Hit {
    float t;
    vec3 normal;
    int materialId;
};

bool intersectSphere(Ray ray, vec3 center, float radius, out Hit hit) {
    vec3 oc = ray.origin - center;
    float a = dot(ray.dir, ray.dir);
    float b = 2.0 * dot(oc, ray.dir);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = b * b - 4.0 * a * c;
    if (discriminant < 0.0) {
        return false;
    }
    float t = (-b - sqrt(discriminant)) / (2.0 * a);
    if (t < 0.001) {
        t = (-b + sqrt(discriminant)) / (2.0 * a);
        if (t < 0.001) {
            return false;
        }
    }
    hit.t = t;
    vec3 hitPos = ray.origin + ray.dir * t;
    hit.normal = normalize(hitPos - center);
    hit.materialId = 0;
    return true;
}

bool intersectPlane(Ray ray, vec3 normal, float d, out Hit hit) {
    float denom = dot(normal, ray.dir);
    if (abs(denom) < 1e-4) {
        return false;
    }
    float t = -(dot(normal, ray.origin) + d) / denom;
    if (t < 0.001) {
        return false;
    }
    hit.t = t;
    hit.normal = normal;
    hit.materialId = 1;
    return true;
}

bool traceScene(Ray ray, out Hit hit) {
    Hit sphereHit;
    Hit planeHit;
    bool hitSomething = false;
    hit.t = 1e20;
    if (intersectSphere(ray, vec3(0.0, 1.0, 0.0), 1.0, sphereHit)) {
        if (sphereHit.t < hit.t) {
            hit = sphereHit;
            hitSomething = true;
        }
    }
    if (intersectPlane(ray, vec3(0.0, 1.0, 0.0), 0.0, planeHit)) {
        if (planeHit.t < hit.t) {
            hit = planeHit;
            hitSomething = true;
        }
    }

    // Dynamic Debug Sphere
    float orbitRadius = 2.5;
    float orbitSpeed = 1.0;
    vec3 orbitPos = vec3(sin(uTime * orbitSpeed) * orbitRadius, 1.0, cos(uTime * orbitSpeed) * orbitRadius);
    Hit debugSphereHit;
    if (intersectSphere(ray, orbitPos, 0.6, debugSphereHit)) {
        if (debugSphereHit.t < hit.t) {
            hit = debugSphereHit;
            hit.materialId = 0;
            hitSomething = true;
        }
    }
    return hitSomething;
}

vec3 shadeHit(Ray ray, Hit hit, vec3 pos) {
    vec3 lightDir = normalize(vec3(-0.4, -1.0, -0.3));
    vec3 lightColor = vec3(1.0, 0.96, 0.9);
    vec3 baseColor = hit.materialId == 0 ? vec3(0.2, 0.6, 1.0) : vec3(0.45, 0.45, 0.45);
    float ndotl = max(dot(hit.normal, -lightDir), 0.0);
    float shadow = 1.0;
    if (uEnableShadows == 1) {
        Ray shadowRay;
        shadowRay.origin = pos + hit.normal * 0.01;
        shadowRay.dir = -lightDir;
        Hit shadowHit;
        if (traceScene(shadowRay, shadowHit)) {
            shadow = 0.25;
        }
    }
    vec3 diffuse = baseColor * ndotl * shadow;
    vec3 ambient = baseColor * 0.15;
    return (diffuse + ambient) * lightColor;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(uResolution.x) || pixel.y >= int(uResolution.y)) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / uResolution;
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.x *= uResolution.x / uResolution.y;

    vec3 camPos = vec3(0.0, 1.2, 4.0);
    vec3 camTarget = vec3(0.0, 0.8, 0.0);
    vec3 forward = normalize(camTarget - camPos);
    vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    vec3 up = cross(right, forward);
    float fov = 1.1;
    vec3 dir = normalize(forward + ndc.x * right * fov + ndc.y * up * fov);

    Ray ray;
    ray.origin = camPos;
    ray.dir = dir;
    vec3 color = vec3(0.0);
    vec3 throughput = vec3(1.0);

    for (int bounce = 0; bounce < uMaxBounces; bounce++) {
        Hit hit;
        if (!traceScene(ray, hit)) {
            vec3 sky = mix(vec3(0.4, 0.6, 0.9), vec3(0.8, 0.9, 1.0), uv.y);
            color += throughput * sky;
            break;
        }
        vec3 pos = ray.origin + ray.dir * hit.t;
        vec3 shaded = shadeHit(ray, hit, pos);
        color += throughput * shaded;

        if (uEnableReflections == 0 || hit.materialId == 1) {
            break;
        }
        throughput *= 0.4;
        ray.origin = pos + hit.normal * 0.01;
        ray.dir = reflect(ray.dir, hit.normal);
    }

    float pulse = 0.5 + 0.5 * sin(uTime);
    color *= mix(0.9, 1.1, pulse);
    imageStore(uOutput, pixel, vec4(color, 1.0));
}
